{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nameOverride",
    "fullnameOverride",
    "replicaCount",
    "image",
    "imagePullSecrets",
    "serviceAccount",
    "podAnnotations",
    "podLabels",
    "service",
    "ingress",
    "autoscaling",
    "persistence",
    "resources",
    "probes",
    "config",
    "secrets",
    "affinity",
    "nodeSelector",
    "tolerations",
    "command",
    "args",
    "extraEnv",
    "podSecurityContext",
    "containerSecurityContext",
    "tmpVolume",
    "podDisruptionBudget",
    "networkPolicy",
    "kafkaAuth",
    "serving",
    "provision",
    "controlPlane",
    "worker",
    "lakeMaterializer",
    "servingBridge",
    "flinkJob"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "secrets": {
            "properties": {
              "create": { "const": false }
            },
            "required": ["create"]
          }
        },
        "required": ["secrets"]
      },
      "then": {
        "properties": {
          "secrets": {
            "properties": {
              "existingSecret": { "type": "string", "minLength": 1 }
            },
            "required": ["existingSecret"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "secrets": {
            "properties": {
              "create": { "const": true }
            },
            "required": ["create"]
          }
        },
        "required": ["secrets"]
      },
      "then": {
        "properties": {
          "secrets": {
            "properties": {
              "existingSecret": { "type": "string", "maxLength": 0 }
            },
            "required": ["existingSecret"]
          }
        }
      }
    }
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "annotations",
        "name",
        "apiName",
        "workerName",
        "provisionName"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "apiName": {
          "type": "string"
        },
        "workerName": {
          "type": "string"
        },
        "provisionName": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "annotations"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "nodePort": {
          "type": "integer",
          "minimum": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "annotations",
        "hosts",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Exact",
                        "ImplementationSpecific",
                        "Prefix"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "secretName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "accessModes",
        "size",
        "storageClassName",
        "mountPath"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClassName": {
          "type": "string"
        },
        "mountPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readiness",
        "liveness"
      ],
      "properties": {
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "clickhouse"],
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["duckdb", "clickhouse"]
        },
        "clickhouse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "database", "user", "existingSecret", "passwordKey"],
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "user": {
              "type": "string",
              "minLength": 1
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            },
            "secure": {
              "type": "boolean"
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["caSecret", "caKey"],
              "properties": {
                "caSecret": {
                  "type": "string"
                },
                "caKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "migrationUser": {
              "type": "string"
            },
            "migrationPasswordKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "backoffLimit"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store"],
      "properties": {
        "store": {
          "type": "string",
          "enum": ["embedded", "postgres"],
          "description": "Where control-plane state (webhook queue/log, alert rules+history, outbox, dead-letter, usage) lives. 'embedded' = per-pod DuckDB + config files, single replica only (the default profile). 'postgres' = the shared PostgresControlPlaneStore adapter (ADR 0010), required for multi-replica: it needs controlPlane.postgres.existingSecret to hold the DSN and serving.backend=clickhouse. The adapter shipped in ADR 0010 rollout slice 5 and the chart profile in slice 6, so the render gate now admits multi-replica once both halves are set."
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "dsnKey"],
          "description": "Scale-profile control-plane store connection (used only when store=postgres). The chart never ships a PostgreSQL service (mirroring how ClickHouse is consumed, ADR 0010): the operator provides the DSN in a Secret and references it here.",
          "properties": {
            "existingSecret": {
              "type": "string",
              "description": "Name of an operator-managed Secret holding the PostgreSQL DSN. Required when store=postgres; the DSN carries a password, so like the ClickHouse password it is never inlined into values."
            },
            "dsnKey": {
              "type": "string",
              "minLength": 1,
              "description": "Key inside existingSecret whose value is the full PostgreSQL DSN (e.g. postgresql://user:pass@host:5432/agentflow). Wired to AGENTFLOW_CONTROLPLANE_PG_DSN."
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount"],
      "description": "Optional dedicated Deployment for delivery loops (AGENTFLOW_PROCESS_ROLE=worker). When enabled the API Deployment is role=api and the Service selects only component=api. Requires controlPlane.store=postgres.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "description": "Optional resource overrides for the worker container; empty object falls back to top-level resources."
        }
      }
    },
    "lakeMaterializer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicaCount",
        "kafkaBootstrapServers",
        "groupId",
        "offsetReset",
        "configPath",
        "catalogUri",
        "warehouse",
        "s3Endpoint",
        "s3Region",
        "existingSecret",
        "accessKeyKey",
        "secretKeyKey"
      ],
      "description": "Optional durable Kafka-to-Iceberg consumer. It owns a Kafka consumer group and commits offsets only after a successful Iceberg append.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "kafkaBootstrapServers": {
          "type": "string"
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "offsetReset": {
          "type": "string",
          "enum": ["earliest", "latest"]
        },
        "configPath": {
          "type": "string",
          "minLength": 1
        },
        "catalogUri": {
          "type": "string"
        },
        "warehouse": {
          "type": "string"
        },
        "s3Endpoint": {
          "type": "string"
        },
        "s3Region": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string"
        },
        "accessKeyKey": {
          "type": "string",
          "minLength": 1
        },
        "secretKeyKey": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object",
          "description": "Optional resource overrides for the materializer container; empty object falls back to top-level resources."
        }
      }
    },
    "servingBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicaCount",
        "kafkaBootstrapServers",
        "groupId",
        "offsetReset",
        "batchMax",
        "metricsPort"
      ],
      "description": "Optional durable Kafka-to-ClickHouse consumer for the serving path.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "kafkaBootstrapServers": {
          "type": "string"
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "offsetReset": {
          "type": "string",
          "enum": ["earliest", "latest"]
        },
        "batchMax": {
          "type": "integer",
          "minimum": 1
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "type": "object",
          "description": "Optional resource overrides for the bridge container; empty object falls back to top-level resources."
        }
      }
    },
    "flinkJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "flinkVersion",
        "serviceAccount",
        "createRbac",
        "kafkaBootstrapServers",
        "inputTopics",
        "groupId",
        "kafkaStartupMode",
        "parallelism",
        "taskSlots",
        "memoryConfiguration",
        "checkpointIntervalMs",
        "checkpointMinPauseMs",
        "restartStrategy",
        "checkpointStorage",
        "savepointStorage",
        "upgradeMode",
        "sessions",
        "jobManager",
        "taskManager",
        "stateBackend"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/properties/image"
        },
        "flinkVersion": {
          "type": "string",
          "const": "v2_3"
        },
        "serviceAccount": {
          "type": "string"
        },
        "createRbac": {
          "type": "boolean"
        },
        "kafkaBootstrapServers": {
          "type": "string"
        },
        "inputTopics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "kafkaStartupMode": {
          "type": "string",
          "enum": ["earliest-offset", "group-offsets"]
        },
        "parallelism": {
          "type": "integer",
          "minimum": 1
        },
        "taskSlots": {
          "type": "integer",
          "minimum": 1
        },
        "memoryConfiguration": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(jobmanager|taskmanager)\\.memory\\.[a-z0-9.-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "checkpointIntervalMs": {
          "type": "integer",
          "minimum": 1
        },
        "checkpointMinPauseMs": {
          "type": "integer",
          "minimum": 0
        },
        "restartStrategy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxFailuresPerInterval",
            "failureRateIntervalMs",
            "delayMs"
          ],
          "properties": {
            "maxFailuresPerInterval": {
              "type": "integer",
              "minimum": 1
            },
            "failureRateIntervalMs": {
              "type": "integer",
              "minimum": 1000
            },
            "delayMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "checkpointStorage": {
          "type": "string"
        },
        "savepointStorage": {
          "type": "string"
        },
        "upgradeMode": {
          "type": "string",
          "enum": ["savepoint", "last-state", "stateless"]
        },
        "sessions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "sourceTopic",
            "sinkTopic",
            "groupId",
            "parallelism",
            "maxUniquePages",
            "maxUniqueProducts"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sourceTopic": {
              "type": "string",
              "minLength": 1
            },
            "sinkTopic": {
              "type": "string",
              "minLength": 1
            },
            "groupId": {
              "type": "string",
              "minLength": 1
            },
            "parallelism": {
              "type": "integer",
              "minimum": 1
            },
            "maxUniquePages": {
              "type": "integer",
              "minimum": 1
            },
            "maxUniqueProducts": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "jobManager": {
          "$ref": "#/definitions/flinkResources"
        },
        "taskManager": {
          "$ref": "#/definitions/flinkResources"
        },
        "stateBackend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "region",
            "pathStyleAccess",
            "existingSecret",
            "accessKeyKey",
            "secretKeyKey"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "pathStyleAccess": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "accessKeyKey": {
              "type": "string",
              "minLength": 1
            },
            "secretKeyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "duckdbPath",
        "usageDbPath",
        "apiKeysPath",
        "tenantsPath",
        "sloPath",
        "securityPath",
        "apiVersionsPath",
        "contractsDir",
        "rateLimitRpm",
        "cacheTtlSeconds",
        "corsOrigins",
        "trustedProxies",
        "redisUrl",
        "otlpEndpoint",
        "otlpServiceName",
        "tenants",
        "slo",
        "security",
        "apiVersions"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["", "demo", "dev", "production"]
        },
        "duckdbPath": {
          "type": "string",
          "minLength": 1
        },
        "usageDbPath": {
          "type": "string",
          "minLength": 1
        },
        "apiKeysPath": {
          "type": "string",
          "minLength": 1
        },
        "tenantsPath": {
          "type": "string",
          "minLength": 1
        },
        "sloPath": {
          "type": "string",
          "minLength": 1
        },
        "securityPath": {
          "type": "string",
          "minLength": 1
        },
        "apiVersionsPath": {
          "type": "string",
          "minLength": 1
        },
        "contractsDir": {
          "type": "string",
          "minLength": 1
        },
        "rateLimitRpm": {
          "type": "integer",
          "minimum": 1
        },
        "cacheTtlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "corsOrigins": {
          "type": "string"
        },
        "trustedProxies": {
          "type": "string",
          "description": "Comma-separated peer addresses permitted to set X-Forwarded-For (AGENTFLOW_TRUSTED_PROXIES). Required behind an ingress on profile=production."
        },
        "redisUrl": {
          "type": "string"
        },
        "otlpEndpoint": {
          "type": "string"
        },
        "otlpServiceName": {
          "type": "string",
          "minLength": 1
        },
        "tenants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenants"
          ],
          "properties": {
            "tenants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "display_name",
                  "kafka_topic_prefix",
                  "max_events_per_day",
                  "max_api_keys"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kafka_topic_prefix": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duckdb_schema": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Ignored. Tenants are isolated by the tenant_id column in each serving table's write key (ADR-004), not by a schema. Still accepted so values written for the old model keep validating; the runtime does not read it."
                  },
                  "max_events_per_day": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_api_keys": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "allowed_entity_types": {
                    "$ref": "#/definitions/stringArrayOrNull"
                  }
                }
              }
            }
          }
        },
        "slo": {
          "type": "string",
          "minLength": 1
        },
        "security": {
          "type": "string",
          "minLength": 1
        },
        "apiVersions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "existingSecret",
        "adminKey",
        "apiKeys"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "adminKey": {
          "type": "string"
        },
        "apiKeys": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keys"
          ],
          "properties": {
            "keys": {
