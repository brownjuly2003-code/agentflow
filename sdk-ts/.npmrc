# Make an engine mismatch fail the install instead of scrolling past as a
# warning. Every sdk-ts lane runs `npm ci` from this directory -- ci.yml's
# required `sdk-ts` job and its `sdk-ts-compat` matrix, security.yml's
# `npm-audit`, and publish-npm.yml -- so all of them inherit the check.
#
# Why it earns a file: PR #252 (Vitest 4 -> 5) went fully green while npm
# printed `npm warn EBADENGINE ... required: { node: '^22.12.0 || ^24.0.0 ||
# >=26.0.0' }, current: { node: 'v20.20.2' }`. The suite ran, so the gate said
# yes to a toolchain the runner's Node does not support. npm makes this check
# against the Node actually installed, which is why it is trusted here instead
# of a semver range re-implemented in a test.
#
# Keep this file credential-free: it is tracked, and `.npmrc` is where npm auth
# tokens conventionally live. Registry auth for publishing comes from
# actions/setup-node's `registry-url` (a separate userconfig file), not here.
engine-strict=true
